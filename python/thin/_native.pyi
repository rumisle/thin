_Op = (
    tuple  # ("r", (value, file, lo, n, part)) | ("p", name) | ("i"|"f", value, text) | ("b", name)
)

class Ins:
    def __init__(
        self,
        target: str,
        form: int,
        ops: list[_Op],
        fields: list[tuple[str, object]],
        mods: bytes | None = None,
    ) -> None: ...
    def with_ops(self, ops: list[_Op]) -> Ins: ...
    def put(self, cls: str, payload: object) -> Ins: ...
    def drop(self, cls: str) -> Ins: ...
    def attr(self, cls: str) -> object | None: ...
    def attr_names(self) -> list[str]: ...
    def ops(self) -> list[tuple[str, object, str]]: ...
    def fields(self) -> list[tuple[str, object]]: ...
    def field(self, name: str) -> object | None: ...
    def mods(self) -> bytes | None: ...
    def facts(
        self,
    ) -> tuple[list[int], list[int], list[int], list[str], list[str], tuple[bool, bool, bool]]: ...
    def width_errors(self, reprs: list[str]) -> list[str]: ...
    def line(self, regs: list[str]) -> str: ...

class Snap:
