"""Type stubs of the extension module thin._native (crates/thin-py).

Arrays are borrowed without a copy and must be C-contiguous; outputs are
arrays the caller allocates. The GIL is released around each core call.
"""

from typing import Any

import numpy as np
import numpy.typing as npt

_U8 = npt.NDArray[np.uint8]
_U32 = npt.NDArray[np.uint32]
_Shape = tuple[int, int, int]
_Encoding = tuple[int, int, bool, str, bool, bool, int, int, float]

